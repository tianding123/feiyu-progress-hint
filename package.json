{
  "name": "feiyu-progress-hint",
  "version": "0.2.0",
  "description": "在输入框正上方挂一条任务进度条：Agent 跑长时间任务（下载/安装/sleep）时出现，正常输出对话后自动消失",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "tianding123",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "progress"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianding123/feiyu-progress-hint.git"
  },
  "homepage": "https://github.com/tianding123/feiyu-progress-hint#readme",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}